# Copy this file to ".env" and fill in your real keys.
# ".env" is listed in .gitignore so it will never be uploaded to GitHub.

# Which provider to use: "groq", "mistral" or "openai"
LLM_PROVIDER=groq

# API keys (you only need the one for the provider you are using)
GROQ_API_KEY=your-groq-key-here
MISTRAL_API_KEY=your-mistral-key-here
OPENAI_API_KEY=your-openai-key-here

# Optional: override the default model names
# GROQ_MODEL=openai/gpt-oss-20b
# MISTRAL_MODEL=mistral-small-latest
# OPENAI_MODEL=gpt-4o-mini

# Optional: rate-limit retry settings
# LLM_MAX_RETRIES=5
# LLM_BACKOFF_BASE=1.0